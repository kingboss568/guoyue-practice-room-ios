require "shellwords"

default_platform(:ios)

ROOT_PATH = File.expand_path("..", __dir__)
ENV_FASTLANE = File.join(ROOT_PATH, ".env.fastlane")

if File.exist?(ENV_FASTLANE)
  File.readlines(ENV_FASTLANE, chomp: true).each do |line|
    next if line.strip.empty? || line.lstrip.start_with?("#")

    key, value = line.split("=", 2)
    next if key.to_s.strip.empty? || value.nil?

    ENV[key.strip] ||= value.strip.gsub(/\A['"]|['"]\z/, "")
  end
end

platform :ios do
  ROOT = ROOT_PATH
  APP_IDENTIFIER = "com.yuhsiangjiang.GuoYueZhiPu"
  VERSION = "1.1"
  METADATA_PATH = File.join(ROOT, "fastlane/metadata")
  SCREENSHOTS_PATH = File.join(ROOT, "fastlane/screenshots")
  VALIDATION_SCRIPT = File.join(ROOT, "fastlane/scripts/validate_submission_ready.sh")

  private_lane :api_key_options do
    key_path = ENV["ASC_KEY_FILE"] || ENV["ASC_API_KEY_PATH"] || ENV["APP_STORE_CONNECT_API_KEY_PATH"]
    key_id = ENV["ASC_KEY_ID"] || ENV["ASC_API_KEY_ID"] || ENV["APP_STORE_CONNECT_API_KEY_ID"]
    issuer_id = ENV["ASC_ISSUER_ID"] || ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"]
    if key_path && !key_path.empty?
      UI.user_error!("ASC_KEY_ID is required when ASC_KEY_FILE is set.") if key_id.to_s.empty?
      UI.user_error!("ASC_ISSUER_ID is required when ASC_KEY_FILE is set.") if issuer_id.to_s.empty?

      {
        api_key: app_store_connect_api_key(
          key_id: key_id,
          issuer_id: issuer_id,
          key_filepath: key_path,
          duration: 1200,
          in_house: false
        )
      }
    else
      {}
    end
  end

  desc "Local preflight: plist, JSON, IAP, asset, and screenshot manifest checks. Allows in-progress warnings."
  lane :validate_local do
    sh("STRICT_READY=0 #{Shellwords.escape(VALIDATION_SCRIPT)}")
  end

  desc "Strict pre-submit gate. Fails if assets, screenshots, git push, or required files are incomplete."
  lane :validate_submission do
    sh("STRICT_READY=1 #{Shellwords.escape(VALIDATION_SCRIPT)}")
  end

  desc "Strict-gated upload of App Store metadata and screenshots only. Does not upload a binary or submit review."
  lane :upload_metadata do
    validate_submission
    deliver(
      **api_key_options,
      app_identifier: APP_IDENTIFIER,
      app_version: VERSION,
      metadata_path: METADATA_PATH,
      screenshots_path: SCREENSHOTS_PATH,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      submit_for_review: false,
      automatic_release: true,
      force: true,
      overwrite_screenshots: true,
      run_precheck_before_submit: true,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Strict-gated App Store listing preparation for Xcode Cloud. Never creates or uploads a local binary."
  lane :prepare_cloud_submission do
    upload_metadata
    UI.success("Metadata and screenshots uploaded. Create Archive -> App Store Connect in Xcode Cloud, wait for VALID, then run submit_review with ASC_BUILD_NUMBER.")
  end

  desc "Select an existing VALID Xcode Cloud build and submit. Requires ASC_BUILD_NUMBER and explicit confirmation."
  lane :submit_review do
    UI.user_error!("Set CONFIRM_SUBMIT_FOR_REVIEW=yes to submit for App Review.") unless ENV["CONFIRM_SUBMIT_FOR_REVIEW"] == "yes"
    cloud_build_number = ENV["ASC_BUILD_NUMBER"].to_s.strip
    UI.user_error!("Set ASC_BUILD_NUMBER to the exact VALID Xcode Cloud build. Fastlane will not create or upload a binary.") if cloud_build_number.empty?
    validate_submission
    deliver(
      **api_key_options,
      app_identifier: APP_IDENTIFIER,
      app_version: VERSION,
      metadata_path: METADATA_PATH,
      screenshots_path: SCREENSHOTS_PATH,
      build_number: cloud_build_number,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: true,
      force: true,
      run_precheck_before_submit: true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        export_compliance_is_exempt: true,
        content_rights_contains_third_party_content: true,
        content_rights_has_rights: true
      }
    )
  end
end
