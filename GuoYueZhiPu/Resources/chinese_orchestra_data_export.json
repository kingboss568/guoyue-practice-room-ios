    {
      "id": "wind",
      "name_zh": "吹管",
      "name_en": "Wind",
      "ordinal": "壹",
      "ordinal_number": 1,
      "blurb_zh": "以氣為魂，讓旋律帶著呼吸前行",
      "description_zh": "吹管聲部包含笛、笙、嗩吶、簫與管子等樂器。它們以氣息、指法、簧片或膜孔形成音色，是國樂團中最直接呈現旋律、民間性格與節慶張力的聲部。",
      "instrument_count": 5,
      "color_hex": "#3D5A48"
    },
    {
      "id": "plucked",
      "name_zh": "彈撥",
      "name_en": "Plucked Strings",
      "ordinal": "貳",
      "ordinal_number": 2,
      "blurb_zh": "顆粒、流動與節奏的骨架",
      "description_zh": "彈撥聲部以琵琶、古箏、揚琴、柳琴、中阮、三弦與箜篌為主。它兼具節奏推進、和聲鋪陳與華彩獨奏能力，是現代國樂團色彩最豐富的聲部之一。",
      "instrument_count": 7,
      "color_hex": "#9B2C1F"
    },
    {
      "id": "bowed",
      "name_zh": "拉弦",
      "name_en": "Bowed Strings",
      "ordinal": "參",
      "ordinal_number": 3,
      "blurb_zh": "近人聲的線條與情感核心",
      "description_zh": "拉弦聲部包含二胡、高胡、中胡、板胡與革胡。它們以弓摩擦琴弦發聲，能做出細膩滑音、顫音與連綿旋律，是國樂團中最接近歌唱性的聲部。",
      "instrument_count": 5,
      "color_hex": "#4B5F8F"
    },
    {
      "id": "percussion",
      "name_zh": "打擊",
      "name_en": "Percussion",
      "ordinal": "肆",
      "ordinal_number": 4,
      "blurb_zh": "時間、場面與戲劇性的推手",
      "description_zh": "打擊聲部涵蓋編鐘、鼓、鑼、鈸、木魚與排鼓。它負責節奏、場面轉換、戲劇張力與音色點染，從宮廷雅樂到民間戲曲都扮演關鍵角色。",
      "instrument_count": 6,
      "color_hex": "#6B4E2E"
    }
  ],
