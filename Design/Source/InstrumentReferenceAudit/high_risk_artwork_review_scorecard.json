    {
      "criterion_id": "differentiation_from_neighbors",
      "label": "Differentiation from similar instruments",
      "required_minimum_score": 4,
      "description": "The image must remain distinct from adjacent Chinese orchestra instruments, especially within the huqin family."
    },
    {
      "criterion_id": "thumbnail_legibility",
      "label": "Thumbnail legibility",
      "required_minimum_score": 4,
      "description": "The defining features must remain visible at app card and App Store screenshot scale."
    },
    {
      "criterion_id": "no_fantasy_details",
      "label": "No fantasy details",
      "required_minimum_score": 4,
      "description": "The image must not add sci-fi, decorative, western substitute, or impossible construction details."
    },
    {
      "criterion_id": "app_store_fit",
      "label": "App Store fit",
      "required_minimum_score": 4,
      "description": "The image must be clean, single-instrument, non-misleading, and suitable for the review build."
